# Application Settings
PROJECT_NAME="Scalable FastAPI REST API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=True

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_db

# Asynchronous Database URL for SQLAlchemy & FastAPI
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_db"

# Synchronous Database URL for Alembic Migrations
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/fastapi_db"

# JWT Authentication
SECRET_KEY="your-super-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
